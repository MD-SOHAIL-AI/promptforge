workspace/builds/*
workspace/artifacts/*
workspace/logs/*
!workspace/projects/.gitkeep
!workspace/builds/.gitkeep
!workspace/artifacts/.gitkeep
!workspace/logs/.gitkeep
workspace/external-projects.json

# Logs, coverage, and packaged output
logs/
out/
coverage/
*.log
