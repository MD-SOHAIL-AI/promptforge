{
  "name": "forgex-desktop",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "ForgeX desktop foundation for the existing Next.js frontend and FastAPI backend.",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "cd frontend && npm run dev",
    "test:python": "python -m pytest -q",
    "build:harness": "npm run build:model-router && tsc -p harness/tsconfig.json",
    "test:harness": "npm run build:harness && node --test harness/tests/*.test.mjs",
    "build:electron": "npm run build:harness && tsc -p electron/tsconfig.json",
    "test:electron": "npm run build:electron && node --test electron/*.test.mjs",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "lint:frontend": "npm --prefix frontend run lint -- --max-warnings=0",
    "build:frontend": "npm --prefix frontend run build",
    "test:release-scripts": "node --test scripts/*.test.mjs",
    "scan:release": "node scripts/scan-release-content.mjs",
    "scan:source-release": "node scripts/scan-release-content.mjs --source-tree .",
    "signoff:esp32": ".venv\\Scripts\\python.exe scripts/esp32_hardware_signoff.py",
    "verify:beta": "node scripts/verify-beta.mjs",
    "dev:electron": "npm run build:electron && electron .",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "setup:platformio": "node scripts/setup-platformio.mjs",
    "logs:live": "node scripts/logs-live.mjs",
    "test:ui-state": "node --experimental-strip-types --test frontend/lib/activity-stream-render.test.mjs frontend/lib/activity-stream.test.mts frontend/lib/workflow-stage-state.test.mts frontend/lib/websocket.test.mts frontend/lib/forge-agent-autonomy.test.mts frontend/lib/forge-agent-activity.test.mts frontend/lib/nexus-agent-view.test.mts frontend/lib/diagnostics.test.mts frontend/lib/agent-stream-policy.test.mts frontend/lib/composer-model-options.test.mts frontend/lib/model-role-bindings.test.mts frontend/lib/code-viewer.test.mts frontend/lib/workspace-helpers.test.mts frontend/lib/workspace-import-policy.test.mts frontend/lib/chat-stream.test.mts frontend/lib/model-provider-status.test.mts frontend/lib/agent-recovery.test.mts frontend/lib/agent-slash-commands.test.mts frontend/lib/frontend-architecture.test.mts frontend/lib/single-flight.test.mts frontend/lib/write-queue.test.mts frontend/lib/backend-proxy.test.mts frontend/lib/settings-write-queue.test.mts frontend/lib/request-deadline.test.mts frontend/lib/message-validation.test.mjs frontend/lib/api-request-diagnostics.test.mjs frontend/lib/verification-state.test.mts",
    "dev:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-cleanup.ps1",
    "test:conversations": "node scripts/test-conversations.mjs",
    "test:read-recovery": "node --experimental-strip-types --test frontend/lib/read-recovery.test.mts frontend/lib/local-session.test.mts",
    "prepare:release": "python scripts/prepare-release.py",
    "scan:package": "node scripts/scan-packaged-content.mjs",
    "package:desktop": "node scripts/release-desktop.mjs",
    "package:test": "node scripts/release-desktop.mjs --unsigned-test",
    "verify:release": "node scripts/verify-release-evidence.mjs",
    "build:model-router": "node scripts/build-model-router.mjs",
    "test:model-router": "npm run build:model-router && node --test model-router/tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "concurrently": "^9.2.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "axios": "1.20.0",
    "@electron/get": "5.1.0",
    "@aws-sdk/shared-ini-file-loader": {
      "ini": "6.0.0"
    },
    "@ai-sdk/provider-utils@^4.0.0": "4.0.57",
    "undici@<6.29.0": "6.29.0",
    "follow-redirects": "1.16.1",
    "shell-quote": "1.11.0"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "1.0.17",
    "@ai-sdk/amazon-bedrock": "4.0.166",
    "@ai-sdk/anthropic": "3.0.111",
    "@ai-sdk/azure": "3.0.93",
    "@ai-sdk/cerebras": "2.0.60",
    "@ai-sdk/cohere": "3.0.27",
    "@ai-sdk/deepinfra": "2.0.41",
    "@ai-sdk/gateway": "3.0.191",
    "@ai-sdk/google": "3.0.73",
    "@ai-sdk/google-vertex": "4.0.181",
    "@ai-sdk/groq": "3.0.31",
    "@ai-sdk/mistral": "3.0.51",
    "@ai-sdk/openai": "3.0.88",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/perplexity": "3.0.26",
    "@ai-sdk/provider": "3.0.16",
    "@ai-sdk/togetherai": "2.0.68",
    "@ai-sdk/vercel": "2.0.39",
    "@ai-sdk/xai": "3.0.102",
    "@aihubmix/ai-sdk-provider": "2.2.1",
    "@aws-sdk/credential-providers": "3.1057.0",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "@qvac/ai-sdk-provider": "0.3.0",
    "@saladtechnologies-oss/ai-sdk-provider": "0.2.0",
    "@smithy/eventstream-codec": "4.2.14",
    "@smithy/util-utf8": "4.2.2",
    "ai": "6.0.168",
    "ai-gateway-provider": "3.2.0",
    "ai-sdk-v7": "npm:ai@7.0.127",
    "aws4fetch": "1.0.20",
    "effect": "4.0.0-beta.83",
    "gitlab-ai-provider": "6.18.0",
    "google-auth-library": "10.5.0",
    "merge-gateway-ai-sdk-provider": "0.3.0",
    "venice-ai-sdk-provider": "2.1.1",
    "watsonx-ai-provider": "2.0.0"
  }
}
