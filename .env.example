# ForgeX local development overrides.
# Copy this file to `.env` only when you need to override defaults.
# Do not put real secrets in `.env.example`.

# Desktop/backend ports
FORGEX_FRONTEND_PORT=3000
FORGEX_BACKEND_PORT=8000

# Python override. Leave blank to let Electron resolve `.venv\Scripts\python.exe`.
# FORGEX_PYTHON=D:\path\to\python.exe

# Model provider selection
# FORGEX_MODEL_PROVIDER=codex_oauth
# FORGEX_MODEL=gpt-5.5

# Codex OAuth bridge
CODEX_OAUTH_ENABLED=true
CODEX_OAUTH_MODEL=gpt-5.5
# On Windows, use codex.cmd if PowerShell script execution blocks the shim.
# CODEX_OAUTH_COMMAND=codex.cmd

# API-key providers. Keep real keys only in your private `.env`.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# FORGEX_NVIDIA_NIM_TIMEOUT_SECONDS=45
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Diagnostics
# FORGEX_LIVE_LOG_PATH=.forgex/logs/live-runtime.jsonl
# FORGEX_LIVE_LOG_MAX_BYTES=1048576

# UI/runtime feature flags
NEXT_PUBLIC_FORGEX_UI_V4=1
FORGEX_ENABLE_AGENT_V3_LOOP=1
# DeepSeek native endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
