FORGEX_ENABLE_OPENAI_API_PROVIDER=0
FORGEX_ENABLE_AGENT_RUNTIME=0
FORGEX_ENABLE_AGENT_RUNTIME_FAKE_PROVIDER=0
# Dev/test only. Deterministic fake coding agent; does not call real APIs.
FORGEX_ENABLE_FAKE_API_CODING_AGENT=0
# Experimental. Enables unified coding-agent workflow adapter. Does not enable real API calls.
FORGEX_ENABLE_UNIFIED_CODING_WORKFLOW=0
# Dev/test only. Enables explicit approved patch apply for unified coding workflows.
FORGEX_ENABLE_PATCH_APPLY=0
# Dev/test only. Required rollback support for explicit approved patch apply.
FORGEX_ENABLE_ROLLBACK_RESTORE=0
# Experimental. Enables review-only API coding-agent generation through model_router.
FORGEX_ENABLE_REAL_API_CODING_AGENT=0
# Experimental. Enables review-only build-failure repair reviews for unified coding-agent workflows.
FORGEX_ENABLE_CODING_AGENT_REPAIR_LOOP=0
FORGEX_ENABLE_API_PROVIDERS=0
FORGEX_ENABLE_GEMINI_PROVIDER=0
FORGEX_ENABLE_GROQ_PROVIDER=0
FORGEX_ENABLE_OPENROUTER_PROVIDER=0
FORGEX_ENABLE_OPENAI_PROVIDER=0
FORGEX_ENABLE_NVIDIA_NIM_PROVIDER=0
